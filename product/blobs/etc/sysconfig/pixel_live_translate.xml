<config>
    <!-- AiAi (Device Personalization Services) needs power-save and data-saver exemptions
         so it can process content capture events and trigger translation in background.
         While AiAi doesn't hold INTERNET itself, it needs to stay alive in background
         to coordinate with PCS (Astrea). -->
    <allow-in-power-save package="com.google.android.as" />
    <allow-in-data-usage-save package="com.google.android.as" />

    <!-- Private Compute Services (Astrea) is the ONLY process that actually downloads
         language packs and ML models from gstatic.com. It MUST be exempted from
         power-save chains and data saver to successfully complete downloads. -->
    <allow-in-power-save package="com.google.android.as.oss" />
    <allow-in-data-usage-save package="com.google.android.as.oss" />

    <!-- Bidirectional IPC association between AiAi and its PCS bridge.
         The reverse direction (oss -> as) is not present in google.xml -->
    <allow-association target="com.google.android.as.oss" allowed="com.google.android.as" />

    <!-- Allow PCS to communicate with GMS for download coordination -->
    <allow-association target="com.google.android.as.oss" allowed="com.google.android.gms" />
</config>
